# Copy to .env.local (never commit real values). Leave blank to keep each feature in labelled demo mode.

# --- Shopify checkout (server-only: no NEXT_PUBLIC_ prefix) ---
SHOPIFY_STORE_DOMAIN=            # e.g. your-store.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN= # Storefront API private access token (Headless channel)
SHOPIFY_STOREFRONT_API_VERSION=2025-10
# Optional JSON override of SKU -> ProductVariant GID mapping, e.g.
# SHOPIFY_VARIANT_MAP={"ISH-N01":"gid://shopify/ProductVariant/1234567890"}
SHOPIFY_VARIANT_MAP=

# --- Appointment requests (server-only). Set EITHER email (Resend) OR a webhook. ---
RESEND_API_KEY=                  # Resend API key; requests are emailed to APPOINTMENT_EMAIL_TO
APPOINTMENT_EMAIL_TO=            # store inbox(es), comma-separated
APPOINTMENT_EMAIL_FROM=          # verified sender, e.g. "ISHÉ Showroom <appointments@your-domain>"
APPOINTMENT_WEBHOOK_URL=         # https URL that receives the request as JSON (e.g. a sheet or CRM automation)

# --- WhatsApp concierge (public: shown in the browser) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=     # international format, e.g. +91 98765 43210

# --- Visit statistics (server-only). Anonymous room/piece events are forwarded here as JSON; blank = discarded. ---
ANALYTICS_WEBHOOK_URL=
